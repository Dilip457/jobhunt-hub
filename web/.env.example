# ── GitHub data source (set on Vercel) ─────────────────────────────
# repo that owns the `data` branch, e.g. Dilip457/jobhunt-hub
GITHUB_REPO=
# fine-grained PAT: Actions read/write + Contents read
GITHUB_TOKEN=
# workflow file name used for manual refresh
GITHUB_WORKFLOW=scrape.yml
# branch that holds the published JSON
GITHUB_DATA_BRANCH=data
# branch the workflow is dispatched from
GITHUB_DISPATCH_REF=main
# public site URL (used for origin checks + metadata), optional
NEXT_PUBLIC_SITE_URL=
# password the hidden refresh dialog asks for; required in production.
# Any password or PIN you can remember (8+ characters, or at least 6 digits).
# Set it only in Vercel's environment variables, never in the code, and
# redeploy after changing it. Use standard keyboard characters only (letters,
# digits, symbols; no accented letters or emoji). Wrong guesses are locked
# out (5 per IP, or more than 30 in total, per 15 minutes). Without it a
# production build refuses every refresh (it fails closed); only `next dev`
# allows refresh with no password.
REFRESH_TOKEN=
